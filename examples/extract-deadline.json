{
  "name": "extract_deadline",
  "adapter_id": "extract_deadline",
  "input_schema": {
    "type": "object",
    "properties": {
      "date": {
        "type": "string",
        "enum": [
          "2024-02-29",
          "2024-02-28",
          "2023-02-28"
        ]
      },
      "context": {
        "type": "string",
        "minLength": 0,
        "maxLength": 64
      },
      "options": {
        "type": "object",
        "properties": {
          "timezone": {
            "type": "string",
            "enum": [
              "UTC",
              "Asia/Shanghai"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 16
            },
            "maxItems": 3
          }
        },
        "additionalProperties": false
      }
    },
    "required": [
      "date"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "deadline": {
        "type": "string",
        "minLength": 10,
        "maxLength": 10
      }
    },
    "required": [
      "deadline"
    ],
    "additionalProperties": false
  }
}